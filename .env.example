# 로컬 실행: 이 파일을 .env 로 복사한 뒤 값을 채우고 `npm run dev`
# (Render 에서는 대시보드 Environment 에 같은 이름으로 입력)

# Postgres 접속 주소. 비워 두면 로컬 임시 DB(PGlite, ./data)를 쓴다 — 로컬 개발 전용.
DATABASE_URL=

# Google AI Studio 에서 발급한 Gemini API 키. 비우면 AI 판독 없이 사진만 저장된다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 위 모델이 없거나(404)·한도 초과(429)일 때 차례로 시도할 모델
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# 로그인 화면에 보일 아이 이름 (쉼표로 구분)
KIDS=박준선,박준혁

# 부모님 메뉴(기록 초기화·비밀번호 재설정) 비밀번호. 비우면 부모님 메뉴가 꺼진다.
ADMIN_CODE=

# 비워 두면 DB 에 한 번 만들어 저장한다
SESSION_SECRET=
PORT=3000
